# NORIA — configuration de production. Copier en .env (chmod 600), ne JAMAIS le versionner.
# Générer les secrets : openssl rand -hex 32

# --- Domaine et HTTPS (Caddy)
NORIA_DOMAIN=noria.exemple.ht

# --- Base PostgreSQL (conteneur « db »)
POSTGRES_USER=noria
POSTGRES_PASSWORD=remplacer-par-openssl-rand-hex-32
POSTGRES_DB=noria

# --- Application (NODE_ENV=production, DATABASE_URL et NORIA_PUBLIC_URL sont fixés par docker-compose.yml)
# NORIA_DEMO=1 est refusé en production.

# --- Envoi des SMS et e-mails (invitations, récupération, codes). Sans réglage : simulé (console), avertissement.
# Voir server/src/notify.js pour la liste complète des variables de chaque fournisseur.
NORIA_SMS_PROVIDER=          # console | twilio | http
NORIA_EMAIL_PROVIDER=        # console | smtp | resend
# Twilio : TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_FROM=+1…  (ou TWILIO_MESSAGING_SERVICE_SID=)
# Passerelle HTTP : NORIA_SMS_HTTP_URL=  NORIA_SMS_HTTP_TOKEN=  NORIA_SMS_SENDER=
# Resend : RESEND_API_KEY=  NORIA_EMAIL_FROM=NORIA <noreply@exemple.ht>
# SMTP : NORIA_SMTP_HOST=  NORIA_SMTP_PORT=587  NORIA_SMTP_STARTTLS=1  NORIA_SMTP_USER=  NORIA_SMTP_PASS=  NORIA_EMAIL_FROM=

# Les sauvegardes ont leur propre fichier : deploy/sauvegarde/sauvegarde.env.example → /etc/noria/sauvegarde.env

# --- Assistant sécurité (super-admin, /#admin → Assistant sécurité). Voir docs/securite-assistant.md.
# NORIA_ASSISTANT_INTERVALLE_MIN=5        # analyse périodique interne (minutes) ; 0 = manuelle seulement
# NORIA_ASSISTANT_SEUILS={"bruteIpAttention":10}   # surcharge JSON des seuils par défaut
# NORIA_ASSISTANT_WEBHOOK_URL=https://hooks.slack.com/services/…   # alerte critique (regroupée, 1 / règle / 30 min)
# NORIA_ASSISTANT_HEALTHCHECKS_URL=https://hc-ping.com/<uuid>      # ping à chaque analyse (/fail si alerte critique)
# NORIA_AUDIT_RAPPORT=/opt/noria/npm-audit.json                    # rapport `npm run audit:rapport` (jamais lancé par le serveur)
# NORIA_TLS_CERT_FILE=                     # certificat à surveiller (sinon : lecture TLS de NORIA_PUBLIC_URL ; 0 via NORIA_ASSISTANT_CERT_RESEAU=0)
# NORIA_ASSISTANT_LLM=                     # désactivé par défaut ; « http » + NORIA_ASSISTANT_LLM_URL (https) + NORIA_ASSISTANT_LLM_TOKEN
# NORIA_BACKUP_AGE_RECIPIENT=age1…         # contrôlée par l'assistant (sauvegardes chiffrées)

# --- Transferts entre écoles (bloc 4). Voir docs/transferts.md.
# NORIA_TRANSFERT_MINISTERE=0              # 1 = étape « autorisation ministère » avant la copie du dossier
# NORIA_TRANSFERT_DELAIS={"demande":3,"consentement":14,"approuve_origine":30}   # délais d'expiration (jours)
