# NORIA — configuration de production. Copier en .env (chmod 600), ne JAMAIS le versionner.
# Générer les secrets : openssl rand -hex 32

# --- Domaine et HTTPS (Caddy)
NORIA_DOMAIN=noria.exemple.ht
# Derrière le proxy Cloudflare (DEPLOIEMENT.md, section 9) : 1 = adresse réelle par CF-Connecting-IP (plages
# Cloudflare seulement) et certificat d'origine Cloudflare ; 0 (défaut) = Let's Encrypt, clients reçus directement.
NORIA_DERRIERE_CLOUDFLARE=0
# NORIA_CF_CERTS_HOTE=./deploy/certs       # dossier de l'hôte contenant origine.pem et origine.key (mode 1)

# --- Secrets de l'application (obligatoires en production ; l'assistant sécurité signale leur absence)
# Clé maîtresse : chiffre les clés de signature des écoles (badges, relevés). 32 octets : openssl rand -hex 32.
# À conserver AUSSI hors du serveur (gestionnaire de mots de passe) : sans elle, les clés en base sont illisibles.
NORIA_CLE_MAITRE=
# Poivre des codes de connexion à 6 chiffres : openssl rand -hex 32.
NORIA_OTP_SECRET=

# --- Base PostgreSQL (conteneur « db »)
POSTGRES_USER=noria
POSTGRES_PASSWORD=remplacer-par-openssl-rand-hex-32
POSTGRES_DB=noria

# --- Application (NODE_ENV=production, DATABASE_URL et NORIA_PUBLIC_URL sont fixés par docker-compose.yml)
# NORIA_DEMO=1 est refusé en production.

# --- Envoi des SMS et e-mails (invitations, récupération, codes). Sans réglage : simulé (console), avertissement.
# Voir server/src/notify.js pour la liste complète des variables de chaque fournisseur.
NORIA_SMS_PROVIDER=          # console | twilio | http
# NORIA_SMS_CONSOLE_ACCEPTE=1          # 1 seulement : SMS simulé voulu (pas de SMS payant). L'assistant ne rouvre plus l'alerte configuration SMS. Redémarrer après modification.
NORIA_EMAIL_PROVIDER=        # console | smtp | resend
# Twilio : TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_FROM=+1…  (ou TWILIO_MESSAGING_SERVICE_SID=)
# Passerelle HTTP : NORIA_SMS_HTTP_URL=  NORIA_SMS_HTTP_TOKEN=  NORIA_SMS_SENDER=
# Resend : RESEND_API_KEY=  NORIA_EMAIL_FROM=NORIA <noreply@exemple.ht>
# SMTP : NORIA_SMTP_HOST=  NORIA_SMTP_PORT=587  NORIA_SMTP_STARTTLS=1  NORIA_SMTP_USER=  NORIA_SMTP_PASS=  NORIA_EMAIL_FROM=

# Les sauvegardes ont leur propre fichier : deploy/sauvegarde/sauvegarde.env.example → /etc/noria/sauvegarde.env

# --- Assistant sécurité (super-admin, /#admin → Assistant sécurité). Voir docs/securite-assistant.md.
# NORIA_ASSISTANT_INTERVALLE_MIN=5        # analyse périodique interne (minutes) ; 0 = manuelle seulement
# NORIA_ASSISTANT_SEUILS={"bruteIpAttention":10}   # surcharge JSON des seuils par défaut
# NORIA_ASSISTANT_WEBHOOK_URL=https://hooks.slack.com/services/…   # alerte critique (regroupée, 1 / règle / 30 min)
# NORIA_ASSISTANT_HEALTHCHECKS_URL=https://hc-ping.com/<uuid>      # ping à chaque analyse (/fail si alerte critique)
# NORIA_AUDIT_RAPPORT=/opt/noria/npm-audit.json                    # rapport `npm run audit:rapport` (jamais lancé par le serveur)
# NORIA_TLS_CERT_FILE=                     # certificat à surveiller (sinon : lecture TLS de NORIA_PUBLIC_URL ; 0 via NORIA_ASSISTANT_CERT_RESEAU=0)
# NORIA_ASSISTANT_LLM=                     # désactivé par défaut ; « http » + NORIA_ASSISTANT_LLM_URL (https) + NORIA_ASSISTANT_LLM_TOKEN
# NORIA_BACKUP_AGE_RECIPIENT=age1…         # contrôlée par l'assistant (sauvegardes chiffrées)

# --- Transferts entre écoles (bloc 4). Voir docs/transferts.md.
# NORIA_TRANSFERT_MINISTERE=0              # 1 = étape « autorisation ministère » avant la copie du dossier
# NORIA_TRANSFERT_DELAIS={"demande":3,"consentement":14,"approuve_origine":30}   # délais d'expiration (jours)

# --- Adresses e-mail des élèves (bloc 7, désactivées par défaut). Voir docs/emails-eleves.md (coûts, branchement).
# NORIA_EMAIL_ELEVES=0                     # 1 = activer (sinon routes, pages et scripts en 404)
# NORIA_EMAIL_DOMAINE=eleve.noria.ht       # domaine des adresses (sous-domaine d'un domaine existant = 0 $)
# NORIA_EMAIL_FOURNISSEUR=simule           # routage entrant : simule | cloudflare | forwardemail
# NORIA_EMAIL_ENVOI=simule                 # envoi des codes : simule | mailgun | noria
# NORIA_EMAIL_EXPEDITEUR="NORIA <no-reply@mg.noria.ht>"
# NORIA_EMAIL_DELAI_JOURS=90               # désactivation après la fin de scolarité
# NORIA_EMAIL_REDIRECTION_JOURS=90         # redirection après un transfert vers une école qui ne garde pas l'adresse
# NORIA_EMAIL_WEBHOOK_SECRET=              # HMAC du webhook /api/emails/entrant (Email Worker catch-all), 24 caractères au moins
# NORIA_CF_API_TOKEN= NORIA_CF_ZONE_ID= NORIA_CF_ACCOUNT_ID=      # Cloudflare Email Routing (gratuit, 200 destinations)
# NORIA_FE_API_TOKEN=                      # Forward Email (Enhanced ~3 $/mois)
# NORIA_MAILGUN_API_KEY= NORIA_MAILGUN_DOMAIN= NORIA_MAILGUN_REGION=us   # Mailgun (gratuit jusqu'à 100/jour)

# --- Diffusion audio des réunions de parents (WHIP → MediaMTX → HLS → R2). Voir docs/reunion-diffusion-r2.md.
# Vide = désactivée (bouton masqué, routes en 404). Démarrer le service avec COMPOSE_PROFILES=diffusion.
# NORIA_DIRECT_URL=https://direct.noriaedu.com          # domaine personnalisé du bucket R2 (segments publics, non listables)
# NORIA_DIRECT_SECRET=                                  # 32 caractères au moins (openssl rand -hex 32)
# NORIA_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# NORIA_R2_BUCKET=noria-direct
# NORIA_R2_ACCESS_KEY_ID=                               # jeton « Object Read & Write » limité au bucket noria-direct
# NORIA_R2_SECRET_ACCESS_KEY=
# NORIA_DIRECT_IP=                                      # IP publique du VPS annoncée en WebRTC (UDP/TCP 8189 à ouvrir)
# NORIA_PAROLE_MAX=1                                    # parents au micro en même temps (1 par défaut, 2 au plus)
# NORIA_DIFFUSION_API=http://diffusion:9997             # API MediaMTX (réseau Docker interne) pour couper un micro
# COMPOSE_PROFILES=diffusion

# Mentions légales sur les factures NORIA (pied de PDF) — à fournir par Philippe
NORIA_RAISON_SOCIALE=
NORIA_NIF=
NORIA_ADRESSE=
