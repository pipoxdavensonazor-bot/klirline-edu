# Caddy devant NORIA : certificat Let's Encrypt automatique (renouvelé seul), redirection HTTP → HTTPS,
# HSTS, compression, cache des fichiers statiques. Le domaine vient de NORIA_DOMAIN (.env).
# Caddy reçoit directement les clients : il ne fait confiance à aucun X-Forwarded-For entrant et le remplace par
# l'adresse réelle ; l'application lit cette valeur (NORIA_TRUST_PROXY=1) pour limiter les tentatives de connexion.

{$NORIA_DOMAIN} {
	encode zstd gzip

	header {
		>Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Fichiers de l'interface (non versionnés par leur nom) : 1 jour en cache, puis revalidation par ETag.
	# index.html et sw.js restent « no-cache » (réglés par l'application) pour que les mises à jour arrivent tout de suite.
	# Portail public (/, /ht, /evenements…) et images /p/img : en-têtes de cache réglés par l'application (bloc 5).
	@statiques path /src/* /manifest.webmanifest
	header @statiques >Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# La sonde de santé n'est pas publique.
	@sante path /healthz
	respond @sante 404

	reverse_proxy app:3100 {
		health_uri /healthz
		health_interval 30s
	}

	log {
		output stdout
		format console
	}
}
