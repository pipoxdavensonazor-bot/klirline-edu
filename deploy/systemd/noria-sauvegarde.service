[Unit]
Description=Sauvegarde chiffrée NORIA (pg_dump → age/AES-256-GCM → S3)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=NORIA_BACKUP_ENV=/etc/noria/sauvegarde.env
ExecStart=/opt/noria/deploy/sauvegarde/noria-sauvegarde.sh
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
