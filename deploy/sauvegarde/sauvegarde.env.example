# Configuration des sauvegardes NORIA → /etc/noria/sauvegarde.env (root:root, chmod 600).
# Lu par noria-sauvegarde.sh et noria-restauration.sh.

# Mêmes valeurs que .env (la sauvegarde passe par « docker compose exec db pg_dump »)
POSTGRES_USER=noria
POSTGRES_DB=noria
COMPOSE="docker compose --project-directory /opt/noria"

BACKUP_DIR=/var/backups/noria
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12

# Chiffrement — choisir UNE méthode.
# 1) age (recommandé) : seule la clé PUBLIQUE est sur le serveur ; la clé privée reste hors ligne (clé USB, coffre).
#    age-keygen -o noria-sauvegarde.key   → ligne « public key: age1… »
NORIA_BACKUP_AGE_RECIPIENT=age1remplacer...
# NORIA_BACKUP_AGE_IDENTITY=/root/noria-sauvegarde.key   # seulement le temps d'une restauration
# 2) AES-256-GCM avec clé symétrique (openssl rand -hex 32) : à conserver AUSSI hors du serveur.
# NORIA_BACKUP_KEY=
# NODE_CMD="docker compose --project-directory /opt/noria exec -T -e NORIA_BACKUP_KEY app node"  # si node absent de l'hôte

# Stockage hors site compatible S3 (adressage par chemin)
#   Cloudflare R2 : S3_ENDPOINT=https://<id-compte>.r2.cloudflarestorage.com  S3_REGION=auto
#   Backblaze B2  : S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com        S3_REGION=us-west-004
#   AWS S3        : S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com             S3_REGION=eu-west-3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PREFIX=noria
# Clé limitée à CE bucket (lecture, écriture, suppression), jamais une clé de compte.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Alerte si la sauvegarde ne passe plus (facultatif, ex. https://hc-ping.com/<uuid>)
NORIA_BACKUP_PING_URL=
